[Unit]
Description=Pre-render and refresh tonight's sunset-aware star-map frame

[Timer]
OnCalendar=*-*-* 12:00:00
OnCalendar=*-*-* 16:20:00
OnCalendar=*-*-* 17:20:00
OnCalendar=*-*-* 18:20:00
OnCalendar=*-*-* 19:20:00
OnCalendar=*-*-* 20:20:00
AccuracySec=1min
RandomizedDelaySec=30s
Persistent=true
Unit=eink-display-render@star-map.service

[Install]
WantedBy=timers.target
